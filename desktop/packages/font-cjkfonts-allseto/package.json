{
  "name": "@lingbo/font-cjkfonts-allseto",
  "type": "module",
  "version": "0.14.1",
  "description": "Essential CSS for font, cjkfonts 全瀨體, used by Lingbo Desk",
  "license": "SIL Open Font License",
  "exports": {
    ".": {
      "default": "./dist/index.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./files/*": {
      "default": "./dist/files/*"
    },
    "./files/*.ttf": {
      "default": "./dist/files/*.ttf"
    },
    "./*": {
      "default": "./*.css"
    }
  },
  "main": "./dist/index.css",
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown"
  }
}
