{
  "name": "@lingbo/better-ws",
  "type": "module",
  "version": "0.14.1",
  "description": "Transport-agnostic reliable WebSocket runtime primitives",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./client/crossws": {
      "types": "./dist/client/crossws.d.mts",
      "default": "./dist/client/crossws.mjs"
    },
    "./server/h3": {
      "types": "./dist/server/h3.d.mts",
      "default": "./dist/server/h3.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "build": "tsdown",
    "dev": "pnpm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/eventa": "catalog:",
    "crossws": "catalog:",
    "h3": "catalog:",
    "srvx": "catalog:"
  }
}
