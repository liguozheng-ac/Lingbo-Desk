    "@moeru/std": "catalog:",
    "@rive-app/canvas-lite": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/motion": "catalog:",
    "vaul-vue": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@unocss/reset": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  }
}
