{
  "name": "@lingbo/ui-loading-screens",
  "type": "module",
  "private": true,
  "description": "A collection of loading screens that used by Lingbo Desk",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./startup-screen": "./src/components/startup-screen.vue",
    "./*": "./*"
  },
  "scripts": {
    "play:dev": "vite",
    "play:build": "vite build",
    "play:preview": "vite preview",
    "build": "echo \"No build step required\"",
