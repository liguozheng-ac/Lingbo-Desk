{
  "name": "@lingbo/plugin-sdk-tamagotchi",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "description": "Tamagotchi-specific DX helpers for Lingbo Desk plugins",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.mts",
      "default": "./dist/widgets/index.mjs"
    },
    "./gamelet": {
      "types": "./dist/gamelet/index.d.mts",
      "default": "./dist/gamelet/index.mjs"
    },
    "./kits/gamelet": {
      "types": "./dist/kits/gamelet/index.d.mts",
      "default": "./dist/kits/gamelet/index.mjs"
    },
    "./kits/tool": {
      "types": "./dist/kits/tool/index.d.mts",
      "default": "./dist/kits/tool/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.mts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "dependencies": {
    "@lingbo/plugin-sdk": "workspace:*",
    "@moeru/eventa": "catalog:",
    "nanoid": "catalog:",
    "valibot": "catalog:",
    "xsschema": "catalog:"
  }
}
