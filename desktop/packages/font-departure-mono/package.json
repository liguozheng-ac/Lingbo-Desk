{
  "name": "@lingbo/font-departure-mono",
  "type": "module",
  "version": "0.14.1",
  "description": "Essential CSS for font, Departure Mono, used by Lingbo Desk",
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./dist/index.css"
    },
    "./index.css": {
      "default": "./dist/index.css"
    },
    "./files/*": {
      "default": "./dist/files/*"
    },
    "./files/*.ttf": {
      "default": "./dist/files/*.ttf"
    },
    "./files/*.otf": {
      "default": "./dist/files/*.otf"
    },
    "./files/*.woff": {
      "default": "./dist/files/*.woff"
    },
    "./files/*.woff2": {
      "default": "./dist/files/*.woff2"
    },
    "./*": {
      "default": "./*.css"
    }
  },
  "main": "./dist/index.css",
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown"
  }
}
