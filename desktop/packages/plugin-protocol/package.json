{
  "name": "@lingbo/plugin-protocol",
  "type": "module",
  "version": "0.14.1",
  "description": "Plugin protocol event definitions and shared websocket types for Lingbo Desk",
  "license": "MIT",
  "exports": {
    "./types": {
      "types": "./dist/types/index.d.mts",
      "default": "./dist/types/index.mjs"
    }
  },
  "main": "./dist/types/index.mjs",
  "types": "./dist/types/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/eventa": "catalog:",
    "@xsai/shared-chat": "catalog:"
  }
}
