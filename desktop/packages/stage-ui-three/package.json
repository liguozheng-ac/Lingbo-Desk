    "@tresjs/cientos": "catalog:",
    "@tresjs/core": "catalog:",
    "@tresjs/post-processing": "catalog:",
    "@vueuse/core": "catalog:",
    "culori": "catalog:",
    "es-toolkit": "catalog:",
    "pinia": "catalog:",
    "postprocessing": "catalog:",
    "three": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/culori": "catalog:",
    "@types/three": "catalog:",
    "vitest": "catalog:vitest",
    "vue-tsc": "catalog:"
  }
