{
  "name": "@lingbo/speech-transformer-chem",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "description": "Reads mhchem chemistry as words, as an extension of speech-transformer-math",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@lingbo/speech-transformer-math": "workspace:*"
  },
  "dependencies": {
    "@lingbo/mathjson": "workspace:*",
    "mhchemparser": "catalog:"
  },
  "devDependencies": {
    "@lingbo/speech-transformer-math": "workspace:*"
  }
}
