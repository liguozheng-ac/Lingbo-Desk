{
  "name": "@lingbo/pipelines-audio",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "description": "Audio pipeline orchestration for LINGBO (capture, VAD, encode, stream)",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@lingbo/stream-kit": "workspace:*",
    "@moeru/eventa": "catalog:",
    "@moeru/std": "catalog:",
    "clustr": "catalog:",
    "nanoid": "catalog:"
  }
}
