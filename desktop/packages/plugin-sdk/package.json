{
  "name": "@lingbo/plugin-sdk",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "description": "Plugin SDK for Lingbo Desk",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin-host": {
      "types": "./dist/plugin-host/index.d.mts",
      "node": "./dist/plugin-host/runtimes/node/index.mjs",
      "default": "./dist/plugin-host/runtimes/web/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "test:run": "vitest run --config vitest.config.ts",
    "build": "tsdown",
    "dev": "pnpm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lingbo/plugin-protocol": "workspace:*",
    "@moeru/eventa": "catalog:",
    "@moeru/std": "catalog:",
    "nanoid": "catalog:",
    "semver": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/semver": "catalog:",
    "es-toolkit": "catalog:"
  }
}
