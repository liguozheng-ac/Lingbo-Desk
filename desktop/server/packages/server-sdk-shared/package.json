{
  "name": "@lingbo/server-sdk-shared",
  "type": "module",
  "version": "0.14.1",
  "private": true,
  "description": "Eventa contracts for the hosted chat WebSocket",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./v2": {
      "types": "./dist/v2.d.mts",
      "default": "./dist/v2.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moeru/eventa": "catalog:",
    "valibot": "catalog:"
  }
}
